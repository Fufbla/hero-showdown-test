# Replace placeholders after selecting an approved staging host and TLS cert.
# This file is a template; no DNS or certificate changes are performed by it.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server {
  listen 443 ssl;
  server_name staging-backend.example.com;
  ssl_certificate /etc/letsencrypt/live/staging-backend.example.com/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/staging-backend.example.com/privkey.pem;
  location = /royale {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_set_header Host $host;
    proxy_read_timeout 75s;
    proxy_send_timeout 75s;
    proxy_buffering off;
  }
  location = /health {
    proxy_pass http://127.0.0.1:8080;
    add_header Cache-Control no-store;
  }
  location / { return 404; }
}
