{
  "name": "healthia-royale",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-reporter=tap tests/*.test.mjs",
    "build:playtest": "node tools/build-playtest.mjs",
    "build:auth": "esbuild auth-provider-entry.mjs --bundle --format=esm --platform=browser --minify --outfile=vendor/auth-provider.mjs",
    "build:server": "esbuild cloud-validation.mjs --bundle --format=esm --platform=neutral --outfile=backend/validation.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.14",
    "@napi-rs/canvas": "0.1.100",
    "esbuild": "0.28.2"
  }
}
