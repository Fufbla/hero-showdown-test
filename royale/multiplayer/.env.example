# Copy to a server-only file readable by the service account. Never publish it.
HOST=127.0.0.1
PORT=8080
ROYALE_DATA=/var/lib/royale/authority.sqlite
ROYALE_ALLOWED_ORIGINS=https://staging.example.com
# Set BOTH only after a representative load test on the actual server.
ROYALE_ROOM_CAPACITY=
ROYALE_SERVER_CAPACITY=
# Needed to reserve/fence old saves. Not needed by the browser.
SUPABASE_SERVICE_ROLE_KEY=
